# Copy to .env.local and fill in. Never commit real values.

# --- LLM: services/ai.service.ts (grounded Q&A + §C.1 structuring) -----------
# Server-side only — no NEXT_PUBLIC_ prefix, or it lands in the client bundle.
GROQ_API_KEY=

# --- Vapi (voice) ------------------------------------------------------------
NEXT_PUBLIC_VAPI_PUBLIC_KEY=   # public by design, safe in the browser
VAPI_PRIVATE_KEY=              # server secret

# --- Upstash Redis: rate limiting + cache (NOT the app database) -------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend: the 14 transactional emails (CDC §I) ----------------------------
RESEND_API_KEY=
RESEND_FROM="MaghrebVoyage <onboarding@resend.dev>"
ADMIN_EMAIL=

# --- Postgres (CDC §5.1) -----------------------------------------------------
# App connection. On Supabase use the TRANSACTION POOLER URI (port 6543).
DATABASE_URL=
# Migrations only. Must be the DIRECT connection (port 5432) — the pooler
# cannot run the DDL and advisory locks `prisma migrate` needs.
DIRECT_URL=

# --- Stripe (CDC §8) — not yet provisioned -----------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
